{
  "name": "homeassistant-kubernetes-panel",
  "version": "1.15.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "vite build --watch --outDir ../.vite-dev",
    "lint": "eslint src/ e2e/",
    "lint:fix": "eslint src/ e2e/ --fix",
    "format": "prettier --write '{src,e2e}/**/*.ts'",
    "format:check": "prettier --check '{src,e2e}/**/*.ts'",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.15.0",
    "eslint-plugin-lit": "^2.3.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
